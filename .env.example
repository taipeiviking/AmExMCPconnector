# Amex Local Finance Connector - safe configuration template
#
# Copy this file to `.env` for local development only. `.env` and every
# `.env.*` variant are ignored. Never put real production secrets, OAuth
# tokens, Amex credentials, account identifiers, statement data, or personal
# financial data in this file. Values ending in `_REF` are references to a
# Windows-protected secret, never the secret value itself.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
AMEX_APP_ENV=development
AMEX_LOG_LEVEL=info
AMEX_START_MINIMIZED=false
AMEX_START_WITH_WINDOWS=false
AMEX_TIMEZONE=Asia/Tokyo
AMEX_TELEMETRY_ENABLED=false
AMEX_CRASH_REPORTING_ENABLED=false
# Keep Windows content protection enabled for production and whenever real
# financial/account data or secrets could appear. For synthetic local UI work
# only, development/test may temporarily set this to false so screenshots can
# be taken; also enable demo mode and use an isolated AMEX_DATA_DIR. Exit every
# running tray instance before changing it, restart after the change, and never
# capture secrets, account data, or real statements. Prefer npm run
# dev:screenshots, which applies the synthetic isolated development settings.
# Production rejects false.
AMEX_SCREENSHOT_PROTECTION=true

# Explicit development-only sample data. Production rejects true.
AMEX_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Local encrypted storage
# ---------------------------------------------------------------------------
# Empty means %LOCALAPPDATA%\AmexLocalFinanceConnector.
AMEX_DATA_DIR=
AMEX_DATABASE_FILE=ledger.db.enc
AMEX_IMPORT_STAGING_DIR=imports
AMEX_EXPORT_DIR=exports
AMEX_LOG_DIR=logs
AMEX_DATABASE_AUTO_LOCK_MINUTES=15
AMEX_LOG_RETENTION_DAYS=90
AMEX_AUDIT_RETENTION_DAYS=2555

# ---------------------------------------------------------------------------
# Local MCP server (read-only tools only)
# ---------------------------------------------------------------------------
# This template is development-only. Packaged production defaults to disabled;
# enabling local or tunnel MCP in production requires bearer authentication.
AMEX_MCP_MODE=local
# Security invariant: this must remain loopback. The app never binds publicly.
AMEX_MCP_HOST=127.0.0.1
AMEX_MCP_PORT=43121
AMEX_MCP_PATH=/mcp
# loopback-only is permitted only for development/test use.
AMEX_MCP_AUTH_MODE=loopback-only
# Required only when AMEX_MCP_AUTH_MODE=bearer. Reference, not token value.
AMEX_MCP_BEARER_TOKEN_REF=wincred:AmexLocalFinanceConnector/McpBearerToken
AMEX_MCP_MAX_PAGE_SIZE=200
AMEX_MCP_REQUEST_TIMEOUT_MS=30000
AMEX_MCP_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# OpenAI Secure MCP Tunnel (optional; requires Platform/workspace authority)
# ---------------------------------------------------------------------------
OPENAI_TUNNEL_ENABLED=false
OPENAI_TUNNEL_AUTO_START=false
OPENAI_TUNNEL_CLIENT_PATH=C:\Path\To\VettedTunnelClient.exe
# Required when enabled: lowercase/uppercase SHA-256 of the reviewed executable.
OPENAI_TUNNEL_CLIENT_SHA256=
# Required when enabled: JSON array from that vetted client's documented CLI.
# It must include {localMcpEndpoint}; optional placeholders are {profile} and {tunnelId}.
# Do not place tokens, keys, or other secrets in this array.
OPENAI_TUNNEL_ARGUMENTS_JSON=[]
OPENAI_TUNNEL_PROFILE=amex-local
OPENAI_TUNNEL_ID=tunnel_REPLACE_WITH_YOUR_TUNNEL_ID
# Credentials and enterprise transport settings belong only in the vetted
# client's already-provisioned protected profile. This app does not copy them
# into command-line arguments, environment variables, or its .env file.

# ---------------------------------------------------------------------------
# U.S. consent-based aggregation (disabled until an approved provider is wired)
# ---------------------------------------------------------------------------
AMEX_US_AGGREGATOR=disabled
AMEX_US_AGGREGATOR_ENVIRONMENT=sandbox
AMEX_US_AGGREGATOR_BASE_URL=https://provider.example.invalid
AMEX_US_AGGREGATOR_CLIENT_ID_REF=wincred:AmexLocalFinanceConnector/UsAggregator/ClientId
AMEX_US_AGGREGATOR_CLIENT_SECRET_REF=wincred:AmexLocalFinanceConnector/UsAggregator/ClientSecret
AMEX_US_OAUTH_AUTHORIZATION_URL=https://provider.example.invalid/oauth/authorize
AMEX_US_OAUTH_TOKEN_URL=https://provider.example.invalid/oauth/token
AMEX_US_OAUTH_REVOCATION_URL=https://provider.example.invalid/oauth/revoke
AMEX_US_AGGREGATOR_REDIRECT_URI=http://127.0.0.1:43122/oauth/callback
AMEX_US_AGGREGATOR_SCOPES=accounts,transactions,statements
AMEX_US_PROVIDER_RESPONSE_PROFILE=normalized_v1
AMEX_US_API_ACCOUNTS_PATH=/v1/accounts
AMEX_US_API_ACCOUNT_STATUS_PATH=/v1/accounts/{providerAccountId}
AMEX_US_API_TRANSACTIONS_PATH=/v1/accounts/{providerAccountId}/transactions
AMEX_US_API_STATEMENTS_PATH=/v1/accounts/{providerAccountId}/statements
AMEX_US_API_STATEMENT_PATH=/v1/accounts/{providerAccountId}/statements/{providerStatementId}
AMEX_US_PROVIDER_MAX_RESPONSE_MB=10
AMEX_US_OAUTH_CALLBACK_PORT=43122
AMEX_US_SYNC_INTERVAL_MINUTES=360
AMEX_US_SYNC_LOOKBACK_DAYS=730
AMEX_US_TOKEN_REFRESH_SKEW_SECONDS=300

# The application never accepts or stores Amex usernames or passwords. There
# are intentionally no AMEX_USERNAME / AMEX_PASSWORD variables.

# ---------------------------------------------------------------------------
# Japan official statement import
# ---------------------------------------------------------------------------
AMEX_JP_IMPORT_MAX_MB=25
AMEX_JP_ALLOWED_EXTENSIONS=.csv,.xlsx,.qif,.pdf
AMEX_JP_CSV_ENCODINGS=utf-8,shift_jis,cp932
AMEX_IMPORT_QUARANTINE_ENABLED=true
AMEX_IMPORT_DUPLICATE_WINDOW_DAYS=7
AMEX_PDF_OCR_ENABLED=false
AMEX_PDF_OCR_ENGINE_PATH=

# ---------------------------------------------------------------------------
# Portfolio, reconciliation, categories, and foreign exchange
# ---------------------------------------------------------------------------
AMEX_DEFAULT_PORTFOLIO_ID=owner-main
AMEX_BASE_CURRENCY=USD
AMEX_FX_RATE_SOURCE=manual
AMEX_FX_PROVIDER_BASE_URL=https://fx-provider.example.invalid
AMEX_FX_PROVIDER_API_KEY_REF=
AMEX_FX_STALE_AFTER_HOURS=24
AMEX_RECONCILIATION_TOLERANCE_MINOR_UNITS=1
# Optional absolute path to a reviewed version-1 UTF-8 JSON rule file. Statement
# category/business-purpose columns are never trusted as owner classifications.
AMEX_CATEGORY_MAPPING_FILE=

# ---------------------------------------------------------------------------
# Review-only anomaly/fraud alerts
# ---------------------------------------------------------------------------
AMEX_ALERTS_ENABLED=true
AMEX_ALERT_LOOKBACK_DAYS=90
AMEX_ALERT_AMOUNT_ZSCORE=3.0
AMEX_ALERT_NEW_MERCHANT_DAYS=180
AMEX_ALERT_HIGH_VALUE_USD=1000
AMEX_ALERT_HIGH_VALUE_JPY=150000

# ---------------------------------------------------------------------------
# Human-approved export packages (never automatic posting)
# ---------------------------------------------------------------------------
# Production rejects false.
AMEX_EXPORT_REQUIRE_HUMAN_APPROVAL=true
AMEX_EXPORT_DUPLICATE_WINDOW_DAYS=365
AMEX_EXPORT_RETENTION_DAYS=30
AMEX_QBO_DEFAULT_FORMAT=csv
AMEX_MONEY_FORWARD_ENCODING=shift_jis
AMEX_MONEY_FORWARD_LINE_ENDING=crlf
