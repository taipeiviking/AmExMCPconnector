coverage/
.vitest/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Codex/projectless working folders (never part of the product repository)
work/
outputs/

# Environment files: commit the documented template only
.env
.env.*
!.env.example

