{
  "name": "amex-local-finance-connector",
  "version": "0.2.3",
  "private": true,
  "description": "Local-first Windows desktop connector for read-only American Express financial data access over MCP.",
  "author": "AmEx MCP Connector contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taipeiviking/AmExMCPconnector.git"
  },
  "bugs": {
    "url": "https://github.com/taipeiviking/AmExMCPconnector/issues"
  },
  "main": "dist/main/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/write-build-channel.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "dev:screenshots": "cross-env AMEX_SCREENSHOT_PROTECTION=false AMEX_DEMO_MODE=true AMEX_DATA_DIR=./local-data/screenshot-development npm run dev",
    "dev:demo": "npm run build && cross-env AMEX_DEMO_MODE=true electron .",
    "smoke:electron": "node scripts/electron-smoke.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "install:win:latest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-latest.ps1 -LaunchAfterInstall",
    "package:win": "cross-env AMEX_BUILD_CHANNEL=unsigned-alpha npm run build && electron-builder --win nsis",
    "verify": "npm run scan:secrets && npm run typecheck && npm test && npm run build && npm run smoke:electron"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "csv-parse": "^6.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2",
    "iconv-lite": "^0.7.0",
    "sql.js": "^1.14.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/sql.js": "^1.4.9",
    "cross-env": "^10.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.localfirst.amexfinanceconnector",
    "productName": "Amex Local Finance Connector",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
